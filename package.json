{
  "name": "zap-elec",
  "version": "1.0.0",
  "desktopName": "whatsapp",
  "description": "Simple web wrapper made with typescript and electron",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "clean": "rm -rf dist release node_modules",
    "tsc": "tsc",
    "build": "tsc && electron-builder",
    "build:linux": "tsc && electron-builder --linux",
    "build:deb": "tsc && electron-builder --linux deb",
    "build:rpm": "tsc && electron-builder --linux rpm",
    "build:pacman": "tsc && electron-builder --linux pacman",
    "build:win": "tsc && electron-builder --win",
    "build:exe": "tsc && electron-builder --win nsis"
  },
  "author": {
    "name": "Jonas Alves",
    "email": "zeropior@proton.me"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "asar": true,
    "compression": "maximum",
    "appId": "com.zap-elec.app",
    "productName": "zap-elec",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "!node_modules",
      "assets/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "assets/icons"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "executableName": "whatsapp",
      "category": "Network",
      "target": [
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "assets/icons",
      "maintainer": "Jonas Alves <zeropior@proton.me>",
      "synopsis": "Electron web wrapper",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Icon": "whatsapp",
          "StartupWMClass": "whatsapp"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "publish": null
  }
}
